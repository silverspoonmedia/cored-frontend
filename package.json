{
  "name": "monolith-vue-workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "npm run build && wrangler dev",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run deploy:production",
    "deploy:production": "cross-env CLOUDFLARE_ENV=production vite build --mode production && wrangler deploy --env production",
    "deploy:sandbox": "cross-env CLOUDFLARE_ENV=sandbox vite build --mode sandbox && wrangler deploy --env sandbox",
    "deploy:staging": "cross-env CLOUDFLARE_ENV=staging vite build --mode staging && wrangler deploy --env staging",
    "cf-typegen": "wrangler types",
    "check:docs": "node scripts/check-docs.mjs",
    "check:env": "node scripts/check-mode-env.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check": "npm run check:docs && npm run check:features && npm run check:i18n && npm run check:env",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-i18n-usage.mjs && node scripts/check-curation-log.mjs",
    "check:i18n:usage": "node scripts/check-i18n-usage.mjs"
  },
  "dependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "admin-lte": "^4.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "glightbox": "^3.3.1",
    "jquery": "^4.0.0",
    "laravel-echo": "^2.4.0",
    "overlayscrollbars": "^2.16.0",
    "pusher-js": "^8.6.0",
    "select2": "^4.1.0",
    "select2-bootstrap-5-theme": "^1.3.0",
    "sweetalert2": "^11.26.25",
    "swiper": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tsconfig/node24": "^24.0.4",
    "@types/jquery": "^4.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.2",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
