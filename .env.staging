# Staging build env — TRACKED. Loaded by `vite build --mode staging`
# (npm run deploy:staging). Values are baked into the browser bundle and
# win over .env.local during builds (verified on Vite 8).

# Staging Laravel API origin (HTTPS, incl. /api/v1).
VITE_API_BASE_URL="https://monolith-staging-api.spnd.uk/api/v1"

# Public hCaptcha sitekey for staging (empty = widget off).
# TODO: swap for a dedicated staging sitekey once the staging Monolith
# instance has its own hCaptcha pair.
VITE_HCAPTCHA_SITE_KEY="db9a097e-d494-47a8-823c-157abb6a74d2"

# Pusher staging credentials — mirror Monolith staging PUSHER_*.
# TODO: swap for dedicated staging credentials once the staging Monolith
# instance has its own Pusher app.
VITE_PUSHER_APP_KEY="118ec9f1a89d12522a83"
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
VITE_PUSHER_APP_CLUSTER="mt1"
