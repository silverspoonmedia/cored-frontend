/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * One codebase, two Workers. The top-level config is the shared base AND the
 * production default; `env.production` / `env.sandbox` only override `name`.
 * Deploy scripts pair each Wrangler env with the same-named Vite mode
 * (`vite build --mode <env>`) so the bundle bakes the matching API origin —
 * `vars` here are runtime isolate env and never reach the browser bundle.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "monolith-spa-prod",
	"compatibility_date": "2026-08-08",
	"main": "server/index.ts",
	"assets": {
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": false,
	"compatibility_flags": [
		"nodejs_compat"
	],
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	"vars": {},
	"env": {
		"production": {
			"name": "monolith-spa-prod",
			"vars": {}
		},
		"sandbox": {
			"name": "monolith-spa-sandbox",
			"vars": {}
		}
	}
}
