# Sandbox build env — TRACKED. Loaded by `vite build --mode sandbox`
# (npm run deploy:sandbox). Values are baked into the browser bundle and
# win over .env.local during builds (verified on Vite 8).

# TODO: set to the sandbox Laravel API origin (HTTPS, incl. /api/v1).
VITE_API_BASE_URL="https://<SANDBOX-API-ORIGIN>/api/v1"

# Public hCaptcha sitekey for sandbox (empty = widget off).
VITE_HCAPTCHA_SITE_KEY=""

# Pusher sandbox credentials — mirror Monolith sandbox PUSHER_*.
VITE_PUSHER_APP_KEY=""
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
VITE_PUSHER_APP_CLUSTER="mt1"
