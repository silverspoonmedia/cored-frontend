# Production build env — TRACKED. Loaded by `vite build --mode production`
# (npm run deploy:production). Values are baked into the browser bundle and
# win over .env.local during builds (verified on Vite 8).

# TODO: set to the production Laravel API origin (HTTPS, incl. /api/v1).
VITE_API_BASE_URL="https://monolith-sandbox-api.spnd.uk/api/v1"

# Public hCaptcha sitekey for production (empty = widget off).
VITE_HCAPTCHA_SITE_KEY=""

# Pusher production credentials — mirror Monolith production PUSHER_*.
VITE_PUSHER_APP_KEY="118ec9f1a89d12522a83"
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
VITE_PUSHER_APP_CLUSTER="mt1"
