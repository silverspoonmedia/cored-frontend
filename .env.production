# Production build environment for the deployed SPA at
# https://monolith-sandbox.spnd.uk — values here are baked into the browser
# bundle by `vite build`, so they are public by definition (never put secrets
# in VITE_*). Loaded automatically in production mode; `.env.local` does NOT
# override it. Keep the variable set in sync with `.env.example`.

# Absolute Laravel API origin for ALL SPA traffic (direct browser -> API).
# Include the /api/v1 path. The Worker serves static assets and does not proxy
# API or auth requests.
VITE_API_BASE_URL="https://monolith-sandbox-api.spnd.uk/api/v1"

# Public hCaptcha sitekey (empty = no widget).
VITE_HCAPTCHA_SITE_KEY=""

# Pusher/Reverb for Echo (must match Monolith PUSHER_* config).
VITE_PUSHER_APP_KEY="118ec9f1a89d12522a83"
VITE_PUSHER_APP_CLUSTER="eu"
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
