# Baseline Vite env — copy to .env (local dev).
# Vite stacks env files: .env < .env.local (dev override) < .env.<mode>
# NOTE: during `vite build --mode production|sandbox` the tracked mode file
# (.env.production / .env.sandbox) wins over .env.local (verified on Vite 8).
# All VITE_* values are baked into the browser bundle at build time.
# Public, non-secret values only — never put secrets here.

# Absolute Laravel API origin including /api/v1. Empty = same-origin only
# (local same-origin dev). Deployed builds must set the HTTPS API origin.
VITE_API_BASE_URL=""

# Public hCaptcha sitekey. Empty = no widget. Pair with Monolith
# platform.hcaptcha.enabled setting.
VITE_HCAPTCHA_SITE_KEY=""

# Pusher/Soketi realtime. Mirror Monolith PUSHER_* literals.
# Empty key = realtime disabled (no polling fallback).
VITE_PUSHER_APP_KEY=""
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
VITE_PUSHER_APP_CLUSTER="mt1"
