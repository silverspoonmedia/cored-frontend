# Absolute Laravel API origin for DATA traffic (direct browser -> API, no Worker
# in the hot path). Auth session endpoints (/api/v1/auth/*) always stay
# same-origin through the Worker BFF, which owns the HttpOnly cookie boundary.
# Leave empty only for local `wrangler dev` against a same-origin API.
# Example: https://monolith-ph24.spnd.uk/api/v1
# .env.local overrides this file.
VITE_API_BASE_URL=""

# Public hCaptcha sitekey (safe to expose). Empty = no widget (monolith captcha off).
# When platform.hcaptcha.enabled is on, set this to the same sitekey as HCAPTCHA_SITEKEY.
VITE_HCAPTCHA_SITE_KEY=""

# Pusher/Reverb for Echo. Empty key = realtime disabled (there is no polling
# fallback; Echo auto-reconnect is the only recovery path).
# Broadcast auth posts to /api/v1/broadcasting/auth (direct, cross-site cookie).
# Values must be literals matching Monolith PUSHER_* (Vite does not expand ${PUSHER_*}).
VITE_PUSHER_APP_KEY=""
VITE_PUSHER_APP_CLUSTER="mt1"
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
