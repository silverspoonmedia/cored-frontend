# Optional emergency override: absolute API prefix baked into the client bundle
# (e.g. https://monolith-ph24.spnd.uk/api/v1). Leave empty so the SPA calls
# same-origin /api/v1 and the Worker masks the monolith host in DevTools.
# .env.local overrides this file — an absolute URL there is why DevTools still
# shows the monolith host after a Vite restart.
VITE_API_BASE_URL=""

# Public hCaptcha sitekey (safe to expose). Empty = no widget (monolith captcha off).
# When platform.hcaptcha.enabled is on, set this to the same sitekey as HCAPTCHA_SITEKEY.
VITE_HCAPTCHA_SITE_KEY=""

# Pusher/Reverb for Echo. Empty key = poll-only fallback.
# Auth uses Bearer → POST /api/v1/broadcasting/auth (same-origin Worker proxy).
# Values must be literals matching Monolith PUSHER_* (Vite does not expand ${PUSHER_*}).
VITE_PUSHER_APP_KEY=""
VITE_PUSHER_APP_CLUSTER="mt1"
VITE_PUSHER_HOST=""
VITE_PUSHER_PORT="443"
VITE_PUSHER_SCHEME="https"
